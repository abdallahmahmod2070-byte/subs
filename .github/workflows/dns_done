name: PureDNS Brute Force Scanner (Optimized + VPN)

on:
  workflow_dispatch:
    inputs:
      target_domain:
        description: 'Target domain to brute force (e.g. example.com)'
        required: true
        default: ''
      wordlist_url:
        description: 'URL of the subdomain wordlist (raw text file)'
        required: false
        # تم التعديل: الرابط الجديد للـ Release الخاص بك
        default: 'https://github.com/abdallahmahmod2070-byte/subs/releases/download/sub/part_00.txt'
      resolver_url:
        description: 'URL of the resolver list (raw text file)'
        required: false
        default: 'https://raw.githubusercontent.com/trickest/resolvers/main/resolvers.txt'

jobs:
  bruteforce:
    name: Brute Force (Chunk ${{ matrix.chunk }})
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        include:
          - chunk: 0
            rate: 330
          - chunk: 1
            rate: 335
          - chunk: 2
            rate: 335

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Go Environment
        uses: actions/setup-go@v5
        with:
          go-version: '>=1.21.0'

      # ----------------------------------------------------------------------
      # الكاش المطور: يخزن Go Modules، Binaries الخاصة بالأدوات، وأيضاً OpenVPN
      # ملاحظة: تمت إضافة /usr/local/bin/puredns للمسارات (كانت ناقصة)
      # ----------------------------------------------------------------------
      - name: Cache Tools (Go, MassDNS, PureDNS, OpenVPN)
        uses: actions/cache@v4
        id: cache-tools
        with:
          path: |
            ~/go/pkg/mod
            ~/go/bin
            /usr/local/bin/massdns
            /usr/local/bin/puredns
            /usr/sbin/openvpn
          key: ${{ runner.os }}-puredns-vpn-v3

      # ----------------------------------------------------------------------
      # تثبيت الأدوات إذا كانت غير موجودة في الكاش
      # ----------------------------------------------------------------------
      - name: Install Dependencies & Tools (if cache miss)
        run: |
          NEED_INSTALL=false
          if [ ! -f /usr/local/bin/massdns ] || [ ! -f /usr/local/bin/puredns ] || [ ! -f /usr/sbin/openvpn ]; then
            NEED_INSTALL=true
          fi

          if [ "$NEED_INSTALL" = true ]; then
            echo "🛠️  Installing required packages (MassDNS, PureDNS, OpenVPN)..."
            sudo apt-get update && sudo apt-get install -y git build-essential libpcap-dev curl openvpn

            # تثبيت MassDNS
            git clone https://github.com/blechschmidt/massdns.git
            cd massdns
            make -j$(nproc)
            sudo cp bin/massdns /usr/local/bin/
            cd .. && rm -rf massdns

            # تثبيت PureDNS
            go install github.com/d3mondev/puredns/v2@latest
            sudo cp $(go env GOPATH)/bin/puredns /usr/local/bin/
          else
            echo "✅ All tools (MassDNS, PureDNS, OpenVPN) are already cached."
          fi

      # ----------------------------------------------------------------------
      # تحميل قائمة Resolvers (جديدة في كل مرة لضمان الحداثة)
      # ----------------------------------------------------------------------
      - name: Download Resolver List
        run: |
          curl -s -L "${{ inputs.resolver_url }}" -o resolvers.txt
          echo "Total resolvers: $(wc -l < resolvers.txt)"

      # ----------------------------------------------------------------------
      # تحميل الـ Wordlist من الرابط المحدد
      # ----------------------------------------------------------------------
      - name: Download Wordlist
        run: |
          curl -s -L "${{ inputs.wordlist_url }}" -o subdomains.txt
          echo "Wordlist size: $(wc -l < subdomains.txt) lines"

      # ----------------------------------------------------------------------
      # تقسيم الـ Wordlist إلى 3 أجزاء للمعالجة المتوازية
      # ----------------------------------------------------------------------
      - name: Split Wordlist into Chunks
        run: |
          split -n l/3 -d -a 1 subdomains.txt chunk_
          for i in 0 1 2; do
            mv "chunk_$i" "chunk_$i.txt"
          done
          echo "Chunk sizes:"
          wc -l chunk_*.txt

      # ----------------------------------------------------------------------
      # الاتصال بالـ VPN - يعمل على كل Runner على حدة
      # تم إصلاح فحص الاتصال: كان بيتحقق فقط من وصول الإنترنت (بيرجع IP حتى
      # من غير VPN)، دلوقتي بيتحقق من لوج الـ openvpn وواجهة tun0 فعليًا
      # ----------------------------------------------------------------------
      - name: Connect to VPN
        run: |
          if [ -n "${{ secrets.VPN_CONFIG }}" ]; then
            echo "🔐 Decoding VPN configuration..."
            echo "${{ secrets.VPN_CONFIG }}" | base64 -d > vpn.ovpn

            if [ -n "${{ secrets.VPN_USERNAME }}" ] && [ -n "${{ secrets.VPN_PASSWORD }}" ]; then
              echo "${{ secrets.VPN_USERNAME }}" > creds.txt
              echo "${{ secrets.VPN_PASSWORD }}" >> creds.txt
              chmod 600 creds.txt
              echo "🔑 Using username/password authentication."
              sudo openvpn --config vpn.ovpn --auth-user-pass creds.txt --auth-nocache --daemon --log-append /tmp/vpn.log
            else
              echo "🔑 Using certificate-only authentication (no user/pass)."
              sudo openvpn --config vpn.ovpn --daemon --log-append /tmp/vpn.log
            fi

            echo "⏳ Waiting for VPN tunnel to establish..."
            VPN_UP=false
            for i in {1..30}; do
              if sudo grep -q "Initialization Sequence Completed" /tmp/vpn.log 2>/dev/null && ip addr show tun0 >/dev/null 2>&1; then
                VPN_UP=true
                break
              fi
              sleep 2
            done

            # مسح ملف الكريدنشلز بعد الاستخدام مباشرة
            rm -f creds.txt

            if [ "$VPN_UP" = true ]; then
              PUBLIC_IP=$(curl -s --max-time 5 ifconfig.me || curl -s --max-time 5 icanhazip.com)
              echo "✅ VPN tunnel is up. Public IP through VPN: $PUBLIC_IP"
            else
              echo "❌ VPN tunnel did not come up within 60s. Traffic will use GitHub's public IP instead."
              echo "--- Last VPN log lines ---"
              sudo tail -n 30 /tmp/vpn.log 2>/dev/null || true
            fi
          else
            echo "⚠️  VPN_CONFIG secret not found. Skipping VPN (requests will use GitHub's public IP)."
          fi

      # ----------------------------------------------------------------------
      # تشغيل PureDNS Brute Force
      # ----------------------------------------------------------------------
      - name: Execute PureDNS Brute Force
        env:
          TARGET: ${{ inputs.target_domain }}
          RATE: ${{ matrix.rate }}
          CHUNK: ${{ matrix.chunk }}
        run: |
          WORDLIST="chunk_${CHUNK}.txt"

          # التحقق من صحة المدخلات
          if [ -z "$TARGET" ]; then
            echo "❌ Error: TARGET domain is empty. Please provide a domain."
            exit 1
          fi

          if [ ! -s "$WORDLIST" ]; then
            echo "❌ Error: Wordlist chunk '$WORDLIST' is empty or missing."
            exit 1
          fi

          echo "🔍 Target: $TARGET"
          echo "⚡ Rate limit: $RATE queries/sec"
          echo "📄 Wordlist chunk: $WORDLIST ($(wc -l < $WORDLIST) entries)"
          echo "--- First 5 subdomains from this chunk ---"
          head -n 5 "$WORDLIST"

          cat "$WORDLIST" | puredns bruteforce "$TARGET" \
            -r resolvers.txt \
            --rate-limit "$RATE" \
            --wildcard-threshold 5 \
            --wildcard-tests 10 \
            -w "found_subs_${CHUNK}.txt" \
            --debug

      # ----------------------------------------------------------------------
      # معالجة النتائج وفرزها
      # تم إصلاح: الخطوة دي كانت من غير env CHUNK فكان بيقرأ ملف اسمه
      # found_subs_.txt (فاضي) بدل found_subs_0.txt / _1.txt / _2.txt
      # ----------------------------------------------------------------------
      - name: Process Results
        env:
          CHUNK: ${{ matrix.chunk }}
        run: |
          if [ -s "found_subs_${CHUNK}.txt" ]; then
            sort -u "found_subs_${CHUNK}.txt" > "live_subdomains_${CHUNK}.txt"
            echo "✅ Discovered $(wc -l < live_subdomains_${CHUNK}.txt) unique subdomains in chunk ${CHUNK}"
            echo "--- Sample results ---"
            head -n 10 "live_subdomains_${CHUNK}.txt"
          else
            touch "live_subdomains_${CHUNK}.txt"
            echo "ℹ️ No valid subdomains found in chunk ${CHUNK}."
          fi

      # ----------------------------------------------------------------------
      # رفع نتائج القطعة الحالية
      # ----------------------------------------------------------------------
      - name: Upload Discovered Subdomains (Chunk ${{ matrix.chunk }})
        uses: actions/upload-artifact@v4
        with:
          name: discovered-subs-chunk-${{ matrix.chunk }}
          path: live_subdomains_${{ matrix.chunk }}.txt

  # --------------------------------------------------------------------------
  # دمج جميع النتائج في ملف واحد
  # --------------------------------------------------------------------------
  merge-results:
    name: Merge All Results
    needs: bruteforce
    runs-on: ubuntu-latest
    if: always()
    steps:
      - name: Download All Artifacts
        uses: actions/download-artifact@v4
        with:
          path: ./all_results

      - name: Merge and Deduplicate
        run: |
          echo "=== Merging all discovered subdomains ==="
          find ./all_results -name "live_subdomains_*.txt" -exec cat {} \; | sort -u > all_discovered_subdomains.txt
          TOTAL=$(wc -l < all_discovered_subdomains.txt)
          echo "✅ Total unique subdomains found: $TOTAL"

          if [ "$TOTAL" -gt 0 ]; then
            echo "=== Full list ==="
            cat all_discovered_subdomains.txt
          else
            echo "No subdomains were discovered."
          fi

      - name: Upload Merged Results
        uses: actions/upload-artifact@v4
        with:
          name: all-discovered-subdomains-merged
          path: all_discovered_subdomains.txt
